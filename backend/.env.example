GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Payment gateway. "mock" (default) needs nothing further and requires no
# internet access — safe for local dev/tests. Set to "zarinpal" to use the
# real gateway (sandbox by default; set ZARINPAL_SANDBOX=0 for production).
PAYMENT_GATEWAY_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=1
PAYMENT_CALLBACK_URL=http://127.0.0.1:8000/api/subscriptions/payments/callback/
PAYMENT_MOCK_GATEWAY_URL=http://127.0.0.1:8000/api/subscriptions/payments/mock-gateway/
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5173/payment/result
